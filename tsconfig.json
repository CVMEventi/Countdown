{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // TypeScript 6 defaults strict to true; this codebase predates that
    "strict": false,
    "target": "ES6",
    "allowJs": true,
    "module": "node16",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "node16",
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["types/**/*.d.ts", "src/**/*"]
}
